  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rs= (2 x G x M/c\xB2)\nOnde, Rs \xE9 o raio de Schwarzschild\nG \xE9 a
    constante gravitacional (6,6743 \xD7 10-11 m3 kg-1 s-2)\nM \xE9 a massa do buraco
    negro\ne c \xE9 a velocidade da luz (3\xD710^8 m/s)\n\nO raio m\xE9dio da Terra
    \xE9 de 6,731 x 10^6 metros. Ao isolarmos a massa, obtemos a equa\xE7\xE3o: \nM
    = ((6,731 x 10^6) x (3 x 10^8)^2)/(2 x 6,674 x 10^(-11))\n\ne o resultado:\nM
    = 4,29 x 10^33"
  m_isRightToLeft: 0
